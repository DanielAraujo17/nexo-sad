# Sem DATABASE_URL, o projeto usa SQLite local em instance/chamados.db.
# Para Supabase, cole a URI PostgreSQL obtida em Project > Connect.
# DATABASE_URL=postgresql://postgres:[SENHA]@[HOST]:5432/postgres

# Defina um segredo aleatório para sessões Flask antes de publicar.
FLASK_SECRET_KEY=troque-por-uma-chave-aleatoria-longa

# Quantidade máxima de chamados resolvidos mantidos no histórico.
HISTORICO_LIMITE=200


# (Opcional) Só para bancos criados por versões antigas do projeto: corrige idade_horas
# de chamados encerrados antes da separação entre idade e tempo de resolução.
# Deixe desligado em bancos novos ou já migrados.
# MIGRAR_IDADE_LEGADA=1
